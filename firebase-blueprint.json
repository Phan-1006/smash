{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Fast-food menu item managed by admin and displayed on the public storefront.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "enum": ["burgers", "pizzas", "chicken", "sides", "drinks"]
        },
        "categoryLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "calories": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "priceUsd": {
          "type": "number"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "tag": {
          "type": "string",
          "maxLength": 30
        },
        "available": {
          "type": "boolean"
        },
        "supportsCombo": {
          "type": "boolean"
        },
        "comboExtraUsd": {
          "type": "number"
        },
        "addons": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "categoryLabel",
        "calories",
        "description",
        "priceUsd",
        "image",
        "available",
        "supportsCombo",
        "comboExtraUsd",
        "addons",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated customer profile and saved delivery preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "defaultAddress": {
          "type": "string",
          "maxLength": 240
        },
        "defaultCity": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Individual fast-food cart line item belonging to an authenticated customer.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "unitPriceUsd": {
          "type": "number"
        },
        "quantity": {
          "type": "integer"
        },
        "variant": {
          "type": "string",
          "enum": ["Solo", "Menu Complet"]
        },
        "addons": {
          "type": "array"
        },
        "notes": {
          "type": "string",
          "maxLength": 180
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "productId",
        "productName",
        "unitPriceUsd",
        "quantity",
        "variant",
        "addons",
        "image",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer fast-food order linked to a live payment transaction reference.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "customerPhone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30
        },
        "deliveryMode": {
          "type": "string",
          "enum": ["delivery", "pickup"]
        },
        "deliveryAddress": {
          "type": "string",
          "minLength": 2,
          "maxLength": 240
        },
        "deliveryLat": {
          "type": "number"
        },
        "deliveryLng": {
          "type": "number"
        },
        "deliveryAccuracy": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "CDF"]
        },
        "subtotalUsd": {
          "type": "number"
        },
        "discountUsd": {
          "type": "number"
        },
        "promoCode": {
          "type": "string",
          "maxLength": 24
        },
        "deliveryFeeUsd": {
          "type": "number"
        },
        "totalAmount": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["MOBILEMONEY", "CARD"]
        },
        "paymentProvider": {
          "type": "string",
          "enum": ["MPESA", "AIRTEL", "ORANGE", "AFRICELL", "VISA_MASTERCARD"]
        },
        "transactionReference": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["PENDING", "PAID", "FAILED"]
        },
        "orderStatus": {
          "type": "string",
          "enum": ["AWAITING_PAYMENT", "PREPARING", "READY", "DELIVERING", "DELIVERED", "CANCELLED"]
        },
        "itemsSummary": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "deliveryMode",
        "deliveryAddress",
        "currency",
        "subtotalUsd",
        "deliveryFeeUsd",
        "totalAmount",
        "paymentMethod",
        "paymentProvider",
        "transactionReference",
        "paymentStatus",
        "orderStatus",
        "itemsSummary",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Publicly readable catalog of fast-food items managed exclusively by the verified admin."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Isolated customer profile and delivery preferences strictly scoped to the owning user."
    },
    "/users/{userId}/cart/{itemId}": {
      "schema": {
        "$ref": "#/entities/CartItem"
      },
      "description": "Synchronized customer shopping cart items strictly owned by userId."
    },
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/Order"
      },
      "description": "Customer orders readable and manageable by the owning customer and verified admin."
    }
  }
}
